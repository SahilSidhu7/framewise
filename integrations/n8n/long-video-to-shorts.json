{
  "name": "AIEditor: long video to captioned shorts (HTTP nodes only)",
  "nodes": [
    {
      "parameters": {},
      "id": "a1",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "fileSelector": "={{ $env.AIEDITOR_INPUT || 'C:/Videos/talk.mp4' }}",
        "options": {}
      },
      "id": "a2",
      "name": "Read video",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ $env.AIEDITOR_URL || 'http://127.0.0.1:8765' }}/v1/files",
        "sendQuery": true,
        "queryParameters": { "parameters": [{ "name": "name", "value": "={{ $binary.data.fileName }}" }] },
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $env.AIEDITOR_KEY }}" }] },
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data",
        "options": {}
      },
      "id": "a3",
      "name": "Upload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AIEDITOR_URL || 'http://127.0.0.1:8765' }}/v1/jobs",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $env.AIEDITOR_KEY }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ recipe: 'reel', inputs: [$json.file_id], style: 'energetic_reel', output: { platform: 'tiktok', length: 30 }, options: { count: 3 } }) }}",
        "options": {}
      },
      "id": "a4",
      "name": "Make 3 reels",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.AIEDITOR_URL || 'http://127.0.0.1:8765' }}/v1/jobs/{{ $json.id }}/wait",
        "sendQuery": true,
        "queryParameters": { "parameters": [{ "name": "timeout", "value": "120" }] },
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $env.AIEDITOR_KEY }}" }] },
        "options": { "timeout": 130000 }
      },
      "id": "a5",
      "name": "Wait for job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            { "leftValue": "={{ $json.state }}", "rightValue": "done", "operator": { "type": "string", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a6",
      "name": "Done?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            { "leftValue": "={{ $json.state }}", "rightValue": "failed", "operator": { "type": "string", "operation": "notEquals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a7",
      "name": "Still running?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1100, 220]
    },
    {
      "parameters": { "fieldToSplitOut": "outputs", "options": {} },
      "id": "a8",
      "name": "One item per file",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [1320, -20]
    },
    {
      "parameters": {
        "url": "={{ ($env.AIEDITOR_URL || 'http://127.0.0.1:8765') + $json.url }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $env.AIEDITOR_KEY }}" }] },
        "options": { "response": { "response": { "responseFormat": "file" } } }
      },
      "id": "a9",
      "name": "Download",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, -20]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "={{ ($env.AIEDITOR_OUTPUT || 'C:/Videos/shorts') + '/' + $('One item per file').item.json.name }}",
        "options": {}
      },
      "id": "a10",
      "name": "Save",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [1760, -20]
    }
  ],
  "connections": {
    "Start": { "main": [[{ "node": "Read video", "type": "main", "index": 0 }]] },
    "Read video": { "main": [[{ "node": "Upload", "type": "main", "index": 0 }]] },
    "Upload": { "main": [[{ "node": "Make 3 reels", "type": "main", "index": 0 }]] },
    "Make 3 reels": { "main": [[{ "node": "Wait for job", "type": "main", "index": 0 }]] },
    "Wait for job": { "main": [[{ "node": "Done?", "type": "main", "index": 0 }]] },
    "Done?": {
      "main": [
        [{ "node": "One item per file", "type": "main", "index": 0 }],
        [{ "node": "Still running?", "type": "main", "index": 0 }]
      ]
    },
    "Still running?": { "main": [[{ "node": "Wait for job", "type": "main", "index": 0 }], []] },
    "One item per file": { "main": [[{ "node": "Download", "type": "main", "index": 0 }]] },
    "Download": { "main": [[{ "node": "Save", "type": "main", "index": 0 }]] }
  },
  "settings": {}
}
